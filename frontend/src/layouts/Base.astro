---
import { Menu, ShieldCheck } from "@lucide/astro";
import "../styles/global.css";

const {
  title = "Agent Reliability Lab — 受治理运行时与评测体系",
} = Astro.props;
const publicName = "Agent Reliability Lab";
const publicSubtitle =
  "Governed Runtime, Evaluation Harness, and Decision Frontier for Tool-Using Agents";
const publicSubtitleZh =
  "面向工具调用智能体的受治理运行时、评测框架与决策边界";
const publicDescription = `${publicName} — ${publicSubtitleZh}。${publicSubtitle}`;
const publicRepository = "https://github.com/I-ivan-x/agent-reliability-lab";

const navigation = [
  ["hero", "概览"],
  ["five-questions", "项目价值"],
  ["governed-runtime", "一次事故"],
  ["reliability-turn", "怎么变可靠"],
  ["q5-decision-frontier", "何时需要模型"],
  ["evaluation-infrastructure", "如何验真"],
  ["evidence-ledger", "完整证据"],
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={publicDescription}
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={publicName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={publicDescription} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={publicDescription} />
    <meta name="theme-color" content="#070b10" />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header" data-sticky-header>
      <nav class="site-nav" aria-label="主要导航">
        <a href="#hero" class="brand-link" aria-label="Agent Reliability Lab 首页">
          <ShieldCheck size={19} strokeWidth={1.8} aria-hidden="true" />
          <span>Agent Reliability Lab</span>
        </a>

        <div class="desktop-nav">
          {
            navigation.slice(1).map(([id, label]) => (
              <a href={`#${id}`}>{label}</a>
            ))
          }
        </div>

        <details class="mobile-nav">
          <summary aria-label="打开章节导航">
            <Menu size={20} aria-hidden="true" />
            <span>章节</span>
          </summary>
          <div class="mobile-nav-panel">
            {
              navigation.map(([id, label]) => (
                <a href={`#${id}`}>{label}</a>
              ))
            }
          </div>
        </details>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <p>Agent Reliability Lab · 公开结论由哈希绑定注册表管理</p>
        <nav class="footer-links" aria-label="项目与复现链接">
          <a
            href={publicRepository}
            target="_blank"
            rel="noreferrer"
            aria-label="源代码（在新标签页打开）"
          >源代码</a>
          <a
            href={`${publicRepository}/blob/main/docs/THREE_MINUTE_DEMO_SCRIPT.md`}
            target="_blank"
            rel="noreferrer"
            aria-label="三分钟脚本（在新标签页打开）"
          >三分钟脚本</a>
          <a
            href={`${publicRepository}/blob/main/data/releases/release_manifest_v2.json`}
            target="_blank"
            rel="noreferrer"
            aria-label="Release Manifest（在新标签页打开）"
          >Release Manifest</a>
        </nav>
      </div>
    </footer>
    <script>
      document.querySelectorAll(".mobile-nav-panel a").forEach((link) => {
        link.addEventListener("click", () => {
          link.closest("details")?.removeAttribute("open");
        });
      });
    </script>
  </body>
</html>
