---
import { Menu, ShieldCheck } from "@lucide/astro";
import "../styles/global.css";

const {
  title = "Agent Reliability Lab — Governed Runtime and Evaluation",
} = Astro.props;
const publicSubtitle =
  "Governed Runtime, Evaluation Harness, and Decision Frontier for Tool-Using Agents";

const navigation = [
  ["hero", "Overview"],
  ["five-questions", "Five Questions"],
  ["governed-runtime", "Runtime"],
  ["reliability-turn", "Reliability"],
  ["q5-decision-frontier", "Q5 Frontier"],
  ["evaluation-infrastructure", "Infrastructure"],
  ["evidence-ledger", "Evidence"],
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={`Agent Reliability Lab — ${publicSubtitle}.`}
    />
    <meta name="theme-color" content="#070b10" />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header" data-sticky-header>
      <nav class="site-nav" aria-label="主要导航">
        <a href="#hero" class="brand-link" aria-label="Agent Reliability Lab 首页">
          <ShieldCheck size={19} strokeWidth={1.8} aria-hidden="true" />
          <span>Agent Reliability Lab</span>
        </a>

        <div class="desktop-nav">
          {
            navigation.slice(1).map(([id, label]) => (
              <a href={`#${id}`}>{label}</a>
            ))
          }
        </div>

        <details class="mobile-nav">
          <summary aria-label="打开章节导航">
            <Menu size={20} aria-hidden="true" />
            <span>章节</span>
          </summary>
          <div class="mobile-nav-panel">
            {
              navigation.map(([id, label]) => (
                <a href={`#${id}`}>{label}</a>
              ))
            }
          </div>
        </details>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <p>Agent Reliability Lab · claims 由 hash-bound registry 管理</p>
        <p class="mono">stable: v3.0-q4-reliability · Q5: scoped_negative_complete</p>
      </div>
    </footer>
  </body>
</html>
