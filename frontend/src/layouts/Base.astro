---
import "../styles/global.css";
const { title = "TrustRAG — 可测、可审、可回归的 AI Agent" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="TrustRAG：fail-closed 企业 RAG-Agent + 反自欺评测治理。零假回答、零越权动作，并把一个诚实的负结果修成正结果。" />
    <title>{title}</title>
  </head>
  <body>
    <header class="sticky top-0 z-20 border-b border-line/70 bg-bg/80 backdrop-blur">
      <nav class="wrap flex h-14 items-center justify-between">
        <a href="#top" class="flex items-center gap-2 font-bold tracking-tight">
          <svg viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2" class="h-5 w-5"
            ><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-4z" /><path d="M9 12l2 2 4-4" /></svg
          >
          TrustRAG
        </a>
        <div class="hidden gap-6 text-sm text-muted md:flex">
          <a href="#arc" class="hover:text-ink">四季 arc</a>
          <a href="#trust" class="hover:text-ink">可信设计</a>
          <a href="#gate" class="hover:text-ink">反作弊门</a>
          <a href="#honest" class="hover:text-ink">诚实工程</a>
        </div>
        <a href="#arc" class="pill border-brand/40 bg-brand-weak text-brand">查看作品</a>
      </nav>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer class="border-t border-line/70 py-10 text-sm text-muted">
      <div class="wrap flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <span>TrustRAG · 单人四季度构建 · 数字均来自真实 run（run_id 标注）</span>
        <span class="num text-faint">v0.3-q1 · v1.0-q2 · v2.0-q3 · v3.0-q4</span>
      </div>
    </footer>

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
