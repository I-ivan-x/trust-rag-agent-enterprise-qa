---
import triad from "../data/triad.json";
const FLOOR = triad.thresholds.AUTH_PRECISION_FLOOR;
const CEIL = triad.thresholds.OVER_ESCALATION_CEIL;
const systems = [
  { name: "Q3 基线 · rule", run: triad.before.run_id, m: triad.before.rule, ring: "border-line" },
  { name: "Q4 校准 · rule", run: triad.after.run_id + " · 留出", m: triad.after.rule, ring: "border-brand/50 shadow-glow" },
  { name: "全升级『作弊者』", run: "解析 · escalate-all", m: triad.cheater, ring: "border-escalate/40" },
];
function metrics(m) {
  return [
    { label: "precision@authorized", v: m["action_precision@authorized"], pass: m["action_precision@authorized"] >= FLOOR, thr: FLOOR * 100, op: "≥ 0.60" },
    { label: "over_escalation_rate", v: m["over_escalation_rate"], pass: m["over_escalation_rate"] <= CEIL, thr: CEIL * 100, op: "≤ 0.30" },
    { label: "unauthorized_blocked", v: m["unauthorized_action_blocked"], pass: m["unauthorized_action_blocked"] >= 1, thr: 100, op: "= 1.00" },
  ];
}
---

<section id="gate" class="border-t border-line/40">
  <div class="wrap stage stage-center">
    <p class="eyebrow reveal">反作弊评测门 · 治理之治理</p>
    <h2 class="reveal measure mt-7 display-2">有用性，只有过了三道指标才算数</h2>
    <p class="reveal mx-auto mt-7 max-w-3xl lead">
      一个只会「升级一切」的作弊者，越权 <span class="num text-ink">100%</span> 拦得住——看着很安全。
      但它 <span class="text-escalate">毫无用处</span>。我的门拦住了它。
    </p>

    <div class="mt-14 grid w-full gap-4 text-left lg:grid-cols-3">
      {
        systems.map((s) => {
          const ok = s.m.anti_gaming_triad_ok;
          return (
            <div class={`reveal card card-hover glass p-6 ${s.ring}`}>
              <div class="flex items-center justify-between">
                <h3 class="font-semibold">{s.name}</h3>
                <span class={`pill ${ok ? "pill-auto" : "pill-escalate"}`}>triad {ok ? "True ✓" : "False"}</span>
              </div>
              <div class="num mt-1 text-xs text-faint">{s.run}</div>
              <div class="mt-5 space-y-4">
                {metrics(s.m).map((mm) => (
                  <div>
                    <div class="flex items-center justify-between text-xs">
                      <span class="text-muted">{mm.label} <span class="text-faint">{mm.op}</span></span>
                      <span class={`num font-semibold ${mm.pass ? "text-brand" : "text-escalate"}`}>{mm.v.toFixed(mm.v < 0.1 ? 4 : 2)}</span>
                    </div>
                    <div class="relative mt-1.5 h-2 overflow-hidden rounded-full bg-surface-2">
                      <div class={`h-full rounded-full ${mm.pass ? "bg-brand" : "bg-escalate"}`} style={`width:${Math.max(2, Math.min(100, mm.v * 100))}%`} />
                      <div class="absolute top-0 h-full w-px bg-ink/50" style={`left:${mm.thr}%`} />
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>

    <p class="reveal mx-auto mt-10 max-w-3xl text-sm leading-relaxed text-muted">
      三栏的 <span class="num">unauthorized_blocked</span> 都是 <span class="num text-brand">1.00</span>——都「安全」。
      但作弊者的 <span class="num text-escalate">precision 0.0588</span>、<span class="num text-escalate">over_escalation 0.80</span> 双双触门。
      <span class="text-ink">安全 ≠ 有用。</span>（LLM 控制器为预注册消融，0.588 仍 False，不冒充 headline。）
    </p>
  </div>
</section>
