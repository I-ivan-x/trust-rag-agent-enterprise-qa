---
import trajectories from "../data/trajectories.json";
const tj = Object.fromEntries(trajectories.map((t) => [t.case_id, t]));
const A = tj["ora-t05"]; // CONFIG_VIOLATION → open_remediation_ticket（授权，走人审）
const B = tj["ora-t15"]; // viewer 越权 → escalate（fail-closed）
const N = 10; // beats
---

<section id="live" class="border-t border-line/40">
  <!-- intro -->
  <div class="wrap stage items-start text-left">
    <p class="eyebrow reveal">看 agent 跑一遍 · 真实留出测试案（q4-p5）</p>
    <h2 class="reveal mt-6 display">读 → 判 → 动 → 治，<br /><span class="gradient-text">一步步看它怎么做决定。</span></h2>
    <p class="reveal mt-8 max-w-2xl lead">向下滚动，跟着 agent 处理一个真实的运维请求——直到它遇上一个<span class="text-escalate">不该执行的越权请求。</span></p>
    <div class="scroll-cue self-start">向下滚动<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M6 13l6 6 6-6" /></svg></div>
  </div>

  <!-- pinned walkthrough -->
  <div class="relative">
    <div class="sticky top-0 flex h-screen items-center overflow-hidden">
      <div class="wrap w-full">
        <div class="mx-auto grid max-w-5xl items-center gap-10 lg:grid-cols-2">
          <div>
            <div id="bk-tag" class="num text-sm text-faint">场景 A · 提问</div>
            <h3 id="bk-big" class="mt-4 text-3xl font-bold leading-tight sm:text-5xl"></h3>
            <p id="bk-sub" class="mt-5 text-lg text-muted"></p>
            <div id="bk-chip" class="mt-6"></div>
          </div>
          <div id="bk-scene" class="min-h-[16rem]"></div>
        </div>
        <div id="bk-dots" class="mt-12 flex justify-center gap-1.5"></div>
      </div>
    </div>
    <div id="bk-rail" style="margin-top:-100vh">
      {Array.from({ length: N }).map((_, i) => <div class="bk-sent h-screen" data-beat={i} />)}
    </div>
  </div>

  <!-- explore more -->
  <div class="wrap py-16 text-center">
    <p class="text-muted">想自己点？下面有全部 5 个场景的紧凑播放器。</p>
    <a href="#explore" class="pill pill-muted card-hover mt-3 px-4 py-2">试试其它场景 ↓</a>
  </div>
</section>

<script define:vars={{ A, B, N }}>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const esc = (s) => String(s ?? "");

  // scene builders (light CSS visuals)
  const docs = (ret, surv) =>
    `<div class="card glass p-6"><div class="text-xs text-muted">检索结果</div>
      <div class="mt-4 flex flex-wrap gap-2">${Array.from({ length: ret })
        .map((_, i) => `<div class="h-10 w-8 rounded ${i < surv ? "bg-brand/25 border border-brand/50" : "bg-surface-2 border border-line"}"></div>`)
        .join("")}</div>
      <div class="mt-4 num text-sm"><span class="text-brand">${surv}</span> <span class="text-muted">通过权限门</span> · <span class="text-faint">${ret - surv} 被拦/丢弃</span></div></div>`;
  const condition = (label, ok) =>
    `<div class="card glass p-8 text-center"><div class="text-xs text-muted">检测到的条件</div>
      <div class="mt-3 text-3xl font-bold ${ok ? "text-detect" : "text-escalate"}">${label}</div>
      <div class="mt-5"><span class="pill ${ok ? "pill-auto" : "pill-escalate"}">${ok ? "用户已授权 ✓" : "用户未授权 ✕"}</span></div></div>`;
  const action = (name, risk) =>
    `<div class="card glass p-8"><div class="text-xs text-muted">拟议动作</div>
      <div class="mt-3 flex items-center justify-between"><span class="text-2xl font-bold text-brand">${name}</span><span class="pill pill-pending">${risk}</span></div>
      <div class="mt-5 h-px bg-line"></div><div class="mt-4 text-sm text-muted">等待治理层裁决…</div></div>`;
  const tray = () =>
    `<div class="card glass p-8"><div class="flex items-center gap-3"><span class="pill pill-pending">开整改工单</span><span class="text-muted">→</span><span class="text-pending font-semibold">待人工审批</span></div>
      <div class="mt-5 rounded-lg border border-pending/30 bg-pending/5 p-4 text-sm text-muted">高风险动作不自动执行——必须有人批准，副作用才生效。</div></div>`;
  const shield = () =>
    `<div class="card glass border-escalate/40 bg-escalate/5 p-8 text-center">
      <svg viewBox="0 0 24 24" fill="none" stroke="#fb7185" stroke-width="1.6" class="mx-auto h-16 w-16"><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-4z"/><path d="M8 8l8 8M16 8l-8 8"/></svg>
      <div class="mt-4 text-2xl font-extrabold text-escalate">越权请求 · 零副作用 · 已升级</div>
      <div class="num mt-2 text-sm text-muted">executed_side_effect = false</div></div>`;
  const bubble = (role, text) =>
    `<div class="card glass p-6"><div class="flex items-center gap-2"><span class="pill ${role === "viewer" ? "pill-escalate" : "pill-detect"}">${role}</span><span class="text-xs text-muted">运维请求</span></div>
      <p class="mt-4 text-lg leading-relaxed">${esc(text)}</p></div>`;

  const beats = [
    { tag: "场景 A · 提问", big: "运维工程师问 agent：", sub: A.query, scene: bubble("admin", A.query) },
    { tag: "① 读 · 检索", big: `它检索了 <span class="text-brand">${A.read.retrieved}</span> 份文档，<span class="text-brand">${A.read.surviving}</span> 份通过权限门`, sub: "证据先过门，再谈动作。", scene: docs(A.read.retrieved, A.read.surviving) },
    { tag: "② 判 · 条件检测", big: `它认出这是一个<span class="text-detect">配置违规</span>，<br>而且这位用户<span class="text-brand">有权</span>处理`, chip: `<span class="pill pill-detect">CONFIG_VIOLATION</span> <span class="pill pill-auto">已授权</span>`, scene: condition("配置违规", true) },
    { tag: "③ 动 · 拟议动作", big: `它提议：<span class="text-brand">开一张整改工单</span>`, sub: "这是一个会触发人类工作流的高风险动作。", chip: `<span class="pill pill-pending">open_remediation_ticket · 高风险</span>`, scene: action("开整改工单", "高风险") },
    { tag: "④ 治 · validator + 路由", big: `因为高风险，它<span class="text-ink">没有自作主张</span>——<br>而是送进<span class="text-pending">人工审批队列</span>`, sub: "agent 知道什么该自己做、什么该交给人。", chip: `<span class="pill pill-pending">approval_state = pending_approval</span>`, scene: tray() },
    { tag: "现在，换个人", big: `那如果一个<span class="text-escalate">没有权限</span>的人，<br>要求它做同样的事呢？`, scene: `<div class="grid h-full place-items-center text-faint"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-20 w-20"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg></div>` },
    { tag: "场景 B · 越权", big: "只读用户（viewer）要求：", sub: B.query, scene: bubble("viewer", B.query) },
    { tag: "判 · 越权检测", big: `agent 发现：这个用户<span class="text-escalate">无权</span>执行此动作`, chip: `<span class="pill pill-escalate">PERMISSION_BLOCKED</span> <span class="pill pill-escalate">未授权</span>`, red: true, scene: condition("权限不足", false) },
    { tag: "治 · fail-closed ★", big: `validator 拦下，<span class="text-escalate">强制升级给人</span>`, sub: "动作根本到不了执行——没有任何副作用落地。", red: true, scene: shield() },
    { tag: "这就是 fail-closed", big: `越权动作<span class="text-escalate">永远到不了执行</span>`, sub: "真实留出测试实测：越权拦截率 100% · F11 = F13 = 0。安全地板是代码强制的，与动作选好选坏无关。", scene: `<div class="card glass p-8 text-center"><div class="num text-6xl font-extrabold text-brand">1.00</div><div class="mt-2 text-sm text-muted">越权动作拦截率（q4-p5 留出）</div></div>` },
  ];

  const $ = (id) => document.getElementById(id);
  const dots = $("bk-dots");
  beats.forEach((_, i) => {
    const d = document.createElement("span");
    d.className = "h-1.5 w-1.5 rounded-full bg-line transition-all duration-300";
    dots.appendChild(d);
  });

  let cur = -1;
  function show(i) {
    if (i === cur) return;
    cur = i;
    const b = beats[i];
    const big = $("bk-big"), wrap = big.closest(".sticky");
    if (!reduce) { big.style.opacity = "0"; big.style.transform = "translateY(10px)"; }
    requestAnimationFrame(() => {
      $("bk-tag").textContent = b.tag;
      big.innerHTML = b.big;
      $("bk-sub").innerHTML = b.sub || "";
      $("bk-chip").innerHTML = b.chip || "";
      $("bk-scene").innerHTML = b.scene || "";
      big.style.transition = reduce ? "none" : "opacity .5s ease, transform .5s ease";
      big.style.opacity = "1"; big.style.transform = "none";
      [...dots.children].forEach((d, k) => {
        d.className = "h-1.5 rounded-full transition-all duration-300 " + (k === i ? "w-6 bg-brand" : "w-1.5 bg-line");
      });
    });
  }

  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) if (e.isIntersecting) show(Number(e.target.dataset.beat));
    },
    { rootMargin: "-50% 0px -50% 0px" },
  );
  document.querySelectorAll(".bk-sent").forEach((s) => io.observe(s));
  show(0);
</script>
