---
import {
  Activity,
  Braces,
  ChevronDown,
  Database,
  Fingerprint,
  GitCompareArrows,
  LockKeyhole,
  Route,
} from "@lucide/astro";
import signalsData from "../data/engineering-signals.json";
import questionsData from "../data/questions.json";
import { claimMeaning, fraction, metricPercent, metricValue } from "../lib/claims";

const allClaims = questionsData.questions.flatMap((question) => question.claims);
const byId = Object.fromEntries(allClaims.map((claim) => [claim.claim_id, claim]));
const q4Safety = byId["q4.release_reliability"];
const q5Controlled = byId["q5.controlled_prose_llm_necessity"];
const q5Uplift = byId["q5.llm_semantic_uplift"];
const q5Safety = signalsData.signals.find(
  (claim) => claim.claim_id === "q5.schema_transition_safety",
)!;
const runtimeStack = [
  ["FastAPI", Route],
  ["Qdrant + BM25 + RRF", Database],
  ["Pydantic 数据契约", Braces],
  ["OpenInference / OTel", Activity],
  ["哈希绑定结论", Fingerprint],
  ["pytest + 发布门禁", LockKeyhole],
];
---

<section
  id="evaluation-infrastructure"
  class="section infrastructure-section"
  data-major-section
  data-section-name="Evaluation Infrastructure"
>
  <div class="wrap">
    <header class="section-heading heading-inline">
      <div>
        <p class="eyebrow">评测基础设施 · 结果如何防伪</p>
        <h2>数字来自原始产物，中文结论由生成器统一生成。</h2>
      </div>
      <p>修改数据却不重生成会失败；修改生成文件而不改注册表也会失败；页面上的公开数字必须反链到证据账本。</p>
    </header>

    <div class="infrastructure-grid">
      <article class="infrastructure-card infrastructure-flow">
        <div class="card-title"><GitCompareArrows size={18} aria-hidden="true" /><h3>四步证据链</h3></div>
        <ol>
          <li><span>01</span><strong>冻结原始产物</strong><small>文件纳入版本管理并计算哈希</small></li>
          <li><span>02</span><strong>绑定指标来源</strong><small>每个数字指向明确字段</small></li>
          <li><span>03</span><strong>生成公开结论</strong><small>范围、状态和中文文案来自单一数据源</small></li>
          <li><span>04</span><strong>浏览器反链</strong><small>页面数字可以回到对应结论</small></li>
        </ol>
      </article>

      <a
        class="infrastructure-card metric-card"
        href={`#evidence-${q4Safety.claim_id}`}
        data-claim-id={q4Safety.claim_id}
      >
        <div class="card-title"><LockKeyhole size={18} aria-hidden="true" /><h3>安全底线</h3></div>
        <strong
          class="large-metric"
          data-metric-claim={q4Safety.claim_id}
          data-metric-name="unauthorized_action_blocked"
        >{fraction(q4Safety.metrics.unauthorized_action_blocked)}</strong>
        <p>{claimMeaning(q4Safety)}</p>
      </a>

      <a
        class="infrastructure-card metric-card"
        href={`#evidence-${q5Controlled.claim_id}`}
        data-claim-id={q5Controlled.claim_id}
      >
        <div class="card-title"><Braces size={18} aria-hidden="true" /><h3>确定性边界</h3></div>
        <strong
          class="large-metric"
          data-metric-claim={q5Controlled.claim_id}
          data-metric-name="previously_uncovered_cases_resolved"
        >{fraction(q5Controlled.metrics.previously_uncovered_cases_resolved)}</strong>
        <p>{claimMeaning(q5Controlled)}</p>
      </a>

      <a
        class="infrastructure-card metric-card"
        href={`#evidence-${q5Uplift.claim_id}`}
        data-claim-id={q5Uplift.claim_id}
      >
        <div class="card-title"><Activity size={18} aria-hidden="true" /><h3>负结果也照实发布</h3></div>
        <div class="efficiency-pair">
          <span
            data-metric-claim={q5Uplift.claim_id}
            data-metric-name="semantic_uplift"
          >
            <strong>{fraction(q5Uplift.metrics.semantic_uplift)}</strong>
            <small>{metricPercent(q5Uplift.metrics.semantic_uplift)}</small>
          </span>
        </div>
        <p>{claimMeaning(q5Uplift)}</p>
      </a>
    </div>

    <details class="infrastructure-technical technical-details">
      <summary>
        <span>技术证据：工程栈与安全分类指标</span>
        <ChevronDown size={17} aria-hidden="true" />
      </summary>
      <div class="metric-triplet">
        {["F11", "F13", "F17"].map((name) => (
          <span data-metric-claim={q5Safety.claim_id} data-metric-name={name}>
            <strong>{metricValue(q5Safety.metrics[name], 0)}</strong><small>{name}</small>
          </span>
        ))}
      </div>
      <div class="stack-strip" aria-label="主要工程栈">
        {runtimeStack.map(([label, Icon]) => (
          <span><Icon size={15} aria-hidden="true" />{label}</span>
        ))}
      </div>
    </details>
  </div>
</section>
