---
import {
  Activity,
  Braces,
  Database,
  Fingerprint,
  Gauge,
  GitCompareArrows,
  LockKeyhole,
  Route,
} from "@lucide/astro";
import signalsData from "../data/engineering-signals.json";
import { fraction, metricValue } from "../lib/claims";

const byId = Object.fromEntries(signalsData.signals.map((claim) => [claim.claim_id, claim]));
const q5Safety = byId["q5.schema_transition_safety"];
const q5Observation = byId["q5.observation_adaptation"];
const q5Efficiency = byId["q5.hybrid_efficiency"];
const runtimeStack = [
  ["FastAPI", Route],
  ["Qdrant + BM25 + RRF", Database],
  ["Pydantic contracts", Braces],
  ["OpenInference / OTel", Activity],
  ["hash-bound claims", Fingerprint],
  ["pytest + release gates", LockKeyhole],
];
---

<section
  id="evaluation-infrastructure"
  class="section infrastructure-section"
  data-major-section
  data-section-name="Evaluation Infrastructure"
>
  <div class="wrap">
    <header class="section-heading heading-inline">
      <div>
        <p class="eyebrow">Evaluation Infrastructure</p>
        <h2>运行时约束与评测可信度，共用一条证据链。</h2>
      </div>
      <p>静态生成的公开视图只读取 canonical claim registry；runtime trace、grader 和 gate 各有独立校验边界。</p>
    </header>

    <div class="infrastructure-grid">
      <article class="infrastructure-card infrastructure-flow">
        <div class="card-title"><GitCompareArrows size={18} aria-hidden="true" /><h3>Evidence pipeline</h3></div>
        <ol>
          <li><span>01</span><strong>Raw artifact</strong><small>tracked, byte-hashed</small></li>
          <li><span>02</span><strong>Metric derivation</strong><small>JSON pointer + tolerance</small></li>
          <li><span>03</span><strong>Claim registry</strong><small>scope + status + lineage</small></li>
          <li><span>04</span><strong>Public view</strong><small>deterministic generation</small></li>
        </ol>
      </article>

      <a
        class="infrastructure-card metric-card"
        href={`#evidence-${q5Safety.claim_id}`}
        data-claim-id={q5Safety.claim_id}
      >
        <div class="card-title"><LockKeyhole size={18} aria-hidden="true" /><h3>Schema + transition safety</h3></div>
        <div class="metric-triplet">
          {["F11", "F13", "F17"].map((name) => (
            <span data-metric-claim={q5Safety.claim_id} data-metric-name={name}>
              <strong>{metricValue(q5Safety.metrics[name], 0)}</strong><small>{name}</small>
            </span>
          ))}
        </div>
        <p>{q5Safety.public_summary}</p>
      </a>

      <a
        class="infrastructure-card metric-card"
        href={`#evidence-${q5Observation.claim_id}`}
        data-claim-id={q5Observation.claim_id}
      >
        <div class="card-title"><Activity size={18} aria-hidden="true" /><h3>Observation completion</h3></div>
        <strong
          class="large-metric"
          data-metric-claim={q5Observation.claim_id}
          data-metric-name="required_observation_recall"
        >{metricValue(q5Observation.metrics.required_observation_recall)}</strong>
        <p>{q5Observation.public_summary}</p>
      </a>

      <a
        class="infrastructure-card metric-card"
        href={`#evidence-${q5Efficiency.claim_id}`}
        data-claim-id={q5Efficiency.claim_id}
      >
        <div class="card-title"><Gauge size={18} aria-hidden="true" /><h3>Selective efficiency</h3></div>
        <div class="efficiency-pair">
          <span data-metric-claim={q5Efficiency.claim_id} data-metric-name="model_call_ratio">
            <strong>{metricValue(q5Efficiency.metrics.model_call_ratio, 6)}</strong>
            <small>calls · {fraction(q5Efficiency.metrics.model_call_ratio)}</small>
          </span>
          <span data-metric-claim={q5Efficiency.claim_id} data-metric-name="token_ratio">
            <strong>{metricValue(q5Efficiency.metrics.token_ratio, 6)}</strong>
            <small>tokens · {fraction(q5Efficiency.metrics.token_ratio)}</small>
          </span>
        </div>
        <p>{q5Efficiency.public_summary}</p>
      </a>
    </div>

    <div class="stack-strip" aria-label="主要工程栈">
      {runtimeStack.map(([label, Icon]) => (
        <span><Icon size={15} aria-hidden="true" />{label}</span>
      ))}
    </div>
  </div>
</section>
