---
import {
  ChevronDown,
  CircleCheck,
  CircleX,
  FileCheck2,
  Gavel,
  ScanSearch,
  Send,
} from "@lucide/astro";
import showcase from "../data/interview-showcase.json";

const views = [
  {
    id: "approval_path",
    label: "正确路径：等待审批",
    status: "等待人工审批",
    statusClass: "status-pass",
    request: showcase.incident.request,
    stages: [
      {
        key: "request",
        label: "请求",
        Icon: Send,
        tone: "stage-cyan",
        primary: "诊断发布异常并尝试回滚",
        secondary: "目标明确，但动作尚未获准执行",
      },
      {
        key: "evidence",
        label: "找证据",
        Icon: FileCheck2,
        tone: "stage-cyan",
        primary: "采用当前手册，隔离冲突资料",
        secondary: `可用证据 ${showcase.evidence.authorized_count} 份 · 阻断 ${showcase.evidence.blocked_count} 份`,
      },
      {
        key: "observation",
        label: "实时观察",
        Icon: ScanSearch,
        tone: "stage-cyan",
        primary: `错误率 ${showcase.observation.error_rate}，超过 ${showcase.observation.threshold} 阈值`,
        secondary: "上一版本健康，满足提出回滚的事实条件",
      },
      {
        key: "proposal",
        label: "提出动作",
        Icon: Gavel,
        tone: "stage-silver",
        primary: "回滚到上一健康版本",
        secondary: "提案引用当前手册和成功的实时观察",
      },
      {
        key: "terminal",
        label: "权限与审批",
        Icon: CircleCheck,
        tone: "stage-amber",
        primary: "系统可以提出回滚方案，但执行前必须审批",
        secondary: "已进入事故负责人审批队列 · 副作用为零",
      },
    ],
  },
  {
    id: "blocked_path",
    label: "危险路径：尝试绕过审批",
    status: "已安全阻断",
    statusClass: "status-reject",
    request: "尝试使用受限例外跳过人工审批。",
    stages: [
      {
        key: "request",
        label: "请求",
        Icon: Send,
        tone: "stage-cyan",
        primary: "请求引用受限例外",
        secondary: "该资料不在当前角色的可见范围",
      },
      {
        key: "evidence",
        label: "证据隔离",
        Icon: FileCheck2,
        tone: "stage-red",
        primary: "只保留不透明标识与阻断原因",
        secondary: "受限正文不会进入可信上下文或动作决策",
      },
      {
        key: "terminal",
        label: "安全停止",
        Icon: CircleX,
        tone: "stage-red",
        primary: "拒绝跳过审批",
        secondary: "没有调用执行工具 · 没有产生副作用",
      },
    ],
  },
];
---

<div
  class="trajectory-player"
  data-trajectory-player
  data-corpus-id={showcase.corpus_id}
  data-manifest-sha={showcase.manifest_sha256}
>
  <div class="trajectory-tabs" role="tablist" aria-label="选择事故处理路径" data-trajectory-tabs>
    {
      views.map((view, index) => (
        <button
          id={`trajectory-tab-${view.id}`}
          type="button"
          role="tab"
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls={`trajectory-panel-${view.id}`}
          tabindex={index === 0 ? 0 : -1}
          data-trajectory-tab
        >
          {view.label}
        </button>
      ))
    }
  </div>

  <div class="trajectory-panels">
    {
      views.map((view, index) => (
        <article
          id={`trajectory-panel-${view.id}`}
          class="trajectory-panel"
          role="tabpanel"
          aria-labelledby={`trajectory-tab-${view.id}`}
          data-trajectory-panel
          data-active={index === 0 ? "true" : "false"}
        >
          <div class="trajectory-context">
            <div>
              <span class="context-label">事故请求</span>
              <p>{view.request}</p>
            </div>
            <span class={`status-chip ${view.statusClass}`}>{view.status}</span>
          </div>

          <ol class="trajectory-stages" aria-label={`${view.label}处理阶段`}>
            {view.stages.map(({ key, label, Icon, tone, primary, secondary }) => (
              <li class={`trajectory-stage ${tone}`} data-stage={key}>
                <span class="trajectory-stage-icon">
                  <Icon size={18} strokeWidth={1.8} aria-hidden="true" />
                </span>
                <div>
                  <span class="stage-label">{label}</span>
                  <strong>{primary}</strong>
                  <small>{secondary}</small>
                </div>
              </li>
            ))}
          </ol>
        </article>
      ))
    }
  </div>

  <details class="trajectory-foot technical-details">
    <summary>
      <span>技术证据：语料血缘与请求标识</span>
      <ChevronDown size={16} aria-hidden="true" />
    </summary>
    <div class="trajectory-foot-grid">
      <div>
        <span>演示语料</span>
        <strong class="mono">{showcase.corpus_id}</strong>
      </div>
      <div>
        <span>观察请求</span>
        <strong class="mono">{showcase.observation.request_id}</strong>
      </div>
      <div>
        <span>Manifest SHA-256</span>
        <strong class="mono">{showcase.manifest_sha256}</strong>
      </div>
    </div>
  </details>

  <p class="trajectory-provenance">虚构合成语料 · 仅用于演示 · 不进入正式结论</p>
</div>

<script>
  const root = document.querySelector("[data-trajectory-player]");
  if (root instanceof HTMLElement) {
    const tabs = Array.from(root.querySelectorAll("[data-trajectory-tab]"));
    const panels = Array.from(root.querySelectorAll("[data-trajectory-panel]"));

    const activate = (tab) => {
      if (!(tab instanceof HTMLButtonElement)) return;
      for (const candidate of tabs) {
        const selected = candidate === tab;
        candidate.setAttribute("aria-selected", String(selected));
        candidate.setAttribute("tabindex", selected ? "0" : "-1");
      }
      for (const panel of panels) {
        const selected = panel.id === tab.getAttribute("aria-controls");
        panel.toggleAttribute("hidden", !selected);
        panel.setAttribute("data-active", String(selected));
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (event) => {
        let next = index;
        if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
        else if (event.key === "ArrowLeft") next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        else return;
        event.preventDefault();
        tabs[next]?.focus();
      });
    });
    activate(tabs[0]);
  }
</script>
