---
import {
  ChevronDown,
  CircleCheck,
  CircleX,
  FileCheck2,
  Gavel,
  ScanSearch,
  Send,
} from "@lucide/astro";
import snapshot from "../data/control-room-trajectory.json";

const actionLabels: Record<string, string> = {
  open_remediation_ticket: "Open remediation ticket",
  escalate_to_human: "Escalate to human",
};
const stateLabels: Record<string, string> = {
  pending_approval: "Pending approval",
  escalated: "Safely escalated",
};

const views = snapshot.scenarios.map((scenario) => ({
  ...scenario,
  label: scenario.scenario_id === "approval_path" ? "Authorized · approval" : "Unauthorized · blocked",
  stages: [
    {
      key: "observation",
      label: "Observation",
      Icon: ScanSearch,
      tone: "stage-cyan",
      primary: `${scenario.observation.retrieved} retrieved · ${scenario.observation.surviving} surviving`,
      secondary: `${scenario.observation.blocked} ACL blocked`,
    },
    {
      key: "evidence",
      label: "Evidence",
      Icon: FileCheck2,
      tone: "stage-cyan",
      primary: scenario.evidence.conditions.join(" · ") || "No condition",
      secondary: `${scenario.evidence.evidence_decision} · actor ${scenario.evidence.authorized_actor ? "authorized" : "unauthorized"}`,
    },
    {
      key: "proposal",
      label: "Proposal",
      Icon: Send,
      tone: "stage-silver",
      primary: actionLabels[scenario.proposal.action] ?? scenario.proposal.action,
      secondary: `${scenario.proposal.controller_source} · ${scenario.proposal.risk_tier}`,
    },
    {
      key: "policy",
      label: "Policy",
      Icon: Gavel,
      tone: "stage-amber",
      primary: `validator ${scenario.policy.validator_ok ? "accepted" : "rejected"}`,
      secondary: scenario.policy.forced_action ?? "no forced action",
    },
    {
      key: "terminal",
      label: "Terminal",
      Icon: scenario.authorized ? CircleCheck : CircleX,
      tone: scenario.authorized ? "stage-amber" : "stage-red",
      primary: stateLabels[scenario.terminal.approval_state] ?? scenario.terminal.approval_state,
      secondary: `side effect ${scenario.terminal.executed_side_effect ? "committed" : "not executed"}`,
    },
  ],
}));
---

<div
  class="trajectory-player"
  data-trajectory-player
  data-run-id={snapshot.provenance.run_id}
  data-source-sha={snapshot.provenance.source_sha256}
>
  <div class="trajectory-tabs" role="tablist" aria-label="选择真实治理轨迹" data-trajectory-tabs>
    {
      views.map((scenario, index) => (
        <button
          id={`trajectory-tab-${scenario.scenario_id}`}
          type="button"
          role="tab"
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls={`trajectory-panel-${scenario.scenario_id}`}
          tabindex={index === 0 ? 0 : -1}
          data-trajectory-tab
        >
          {scenario.label}
        </button>
      ))
    }
  </div>

  <div class="trajectory-panels">
    {
      views.map((scenario, index) => (
        <article
          id={`trajectory-panel-${scenario.scenario_id}`}
          class="trajectory-panel"
          role="tabpanel"
          aria-labelledby={`trajectory-tab-${scenario.scenario_id}`}
          data-trajectory-panel
          data-active={index === 0 ? "true" : "false"}
        >
          <div class="trajectory-context">
            <div>
              <span class="context-label">Runtime request · {scenario.actor_role}</span>
              <p>{scenario.query}</p>
            </div>
            <span class={`status-chip ${scenario.authorized ? "status-pass" : "status-reject"}`}>
              {scenario.authorized ? "authorized" : "permission blocked"}
            </span>
          </div>

          <ol class="trajectory-stages" aria-label={`${scenario.label} stages`}>
            {scenario.stages.map(({ key, label, Icon, tone, primary, secondary }) => (
              <li class={`trajectory-stage ${tone}`} data-stage={key}>
                <span class="trajectory-stage-icon">
                  <Icon size={18} strokeWidth={1.8} aria-hidden="true" />
                </span>
                <div>
                  <span class="stage-label">{label}</span>
                  <strong>{primary}</strong>
                  <small>{secondary}</small>
                </div>
              </li>
            ))}
          </ol>

          <details class="trajectory-foot">
            <summary>
              <span>Trace lineage · citations + terminal record</span>
              <ChevronDown size={16} aria-hidden="true" />
            </summary>
            <div class="trajectory-foot-grid">
              <div>
                <span>Evidence citations</span>
                <ul>
                  {scenario.observation.citations.map((citation) => <li class="mono">{citation}</li>)}
                </ul>
              </div>
              <div>
                <span>Terminal record</span>
                <strong class="mono">{scenario.terminal.sink_record_id ?? "none"}</strong>
              </div>
            </div>
          </details>
        </article>
      ))
    }
  </div>

  <p class="trajectory-provenance mono">
    real · {snapshot.provenance.run_id} · source {snapshot.provenance.source_sha256.slice(0, 12)}…
  </p>
</div>

<script>
  const root = document.querySelector("[data-trajectory-player]");
  if (root instanceof HTMLElement) {
    const tabs = Array.from(root.querySelectorAll("[data-trajectory-tab]"));
    const panels = Array.from(root.querySelectorAll("[data-trajectory-panel]"));

    const activate = (tab) => {
      if (!(tab instanceof HTMLButtonElement)) return;
      for (const candidate of tabs) {
        const selected = candidate === tab;
        candidate.setAttribute("aria-selected", String(selected));
        candidate.setAttribute("tabindex", selected ? "0" : "-1");
      }
      for (const panel of panels) {
        const selected = panel.id === tab.getAttribute("aria-controls");
        panel.toggleAttribute("hidden", !selected);
        panel.setAttribute("data-active", String(selected));
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (event) => {
        let next = index;
        if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
        else if (event.key === "ArrowLeft") next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        else return;
        event.preventDefault();
        tabs[next]?.focus();
      });
    });
    activate(tabs[0]);
  }
</script>
