---
import {
  ChevronDown,
  FileCheck2,
  Fingerprint,
} from "@lucide/astro";
import questionsData from "../data/questions.json";
import { fraction, metricValue, statusLabel, statusTone } from "../lib/claims";

const claims = questionsData.questions.flatMap((question) => question.claims);
---

<section
  id="evidence-ledger"
  class="section ledger-section"
  data-major-section
  data-section-name="Evidence Ledger"
>
  <div class="wrap">
    <header class="section-heading heading-inline">
      <div>
        <p class="eyebrow">Evidence Ledger · canonical registry</p>
        <h2>每条公开结论都能回到原始 artifact。</h2>
      </div>
      <p>负结论与 not evaluated 不折叠出视野；使用键盘可展开完整 lineage、metric derivation 与 limitations。</p>
    </header>

    <div class="ledger-toolbar" role="note">
      <FileCheck2 size={17} aria-hidden="true" />
      <span><strong>{claims.length} claims</strong> · Q1–Q5 · generated from tracked registry</span>
      <span class="mono">schema public-claim-registry-v2</span>
    </div>

    <div class="ledger-list">
      {
        claims.map((claim) => (
          <details
            id={`evidence-${claim.claim_id}`}
            class={`ledger-item ${statusTone(claim.status)}`}
            data-claim-id={claim.claim_id}
          >
            <summary>
              <span class="ledger-claim-id mono">{claim.claim_id}</span>
              <span class="ledger-summary-copy">
                <strong>{claim.public_label}</strong>
                <small>{claim.claim_scope}</small>
              </span>
              <span class="ledger-state">
                <strong>{statusLabel(claim.status)}</strong>
                <small>headline {String(claim.headline_eligible)}</small>
              </span>
              <ChevronDown class="ledger-chevron" size={18} aria-hidden="true" />
            </summary>

            <div class="ledger-body">
              <div class="ledger-conclusion">
                <h3>Public conclusion</h3>
                <p>{claim.public_summary}</p>
                <dl>
                  <div><dt>Evidence mode</dt><dd>{claim.evidence_mode}</dd></div>
                  <div><dt>Frozen scope</dt><dd>{claim.split_or_frozen_scope}</dd></div>
                  <div><dt>Status</dt><dd>{claim.status_label}</dd></div>
                </dl>
              </div>

              <div class="ledger-metrics">
                <h3>Metrics</h3>
                {Object.keys(claim.metrics).length === 0 ? (
                  <p class="ledger-empty">No metric: this claim is explicitly not evaluated.</p>
                ) : (
                  <div class="metric-table" role="table" aria-label={`${claim.claim_id} metrics`}>
                    {Object.entries(claim.metrics).map(([name, metric]) => (
                      <div
                        class="metric-row"
                        role="row"
                        data-metric-claim={claim.claim_id}
                        data-metric-name={name}
                      >
                        <span role="cell" class="mono">{name}</span>
                        <strong role="cell">{metricValue(metric, 6)}</strong>
                        <span role="cell" class="mono">{fraction(metric)}</span>
                        <span role="cell">{metric.source.derivation}</span>
                      </div>
                    ))}
                  </div>
                )}
              </div>

              <div class="ledger-sources">
                <h3><Fingerprint size={16} aria-hidden="true" /> Source lineage</h3>
                {claim.source_artifacts.map((source) => (
                  <dl class="source-record">
                    <div><dt>run_id</dt><dd class="mono">{source.run_id}</dd></div>
                    <div><dt>source_path</dt><dd class="mono">{source.path}</dd></div>
                    <div><dt>artifact_sha256</dt><dd class="mono">{source.sha256}</dd></div>
                    <div><dt>execution_commit</dt><dd class="mono">{source.execution_commit}</dd></div>
                    <div><dt>artifact_commit</dt><dd class="mono">{source.artifact_commit}</dd></div>
                    <div><dt>release_tag</dt><dd class="mono">{source.release_tag ?? "none"}</dd></div>
                  </dl>
                ))}
              </div>

              <div class="ledger-limitations">
                <h3>Limitations</h3>
                <ul>{claim.limitations.map((limitation) => <li>{limitation}</li>)}</ul>
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
