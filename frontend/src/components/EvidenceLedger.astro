---
import {
  ChevronDown,
  FileCheck2,
  Fingerprint,
} from "@lucide/astro";
import questionsData from "../data/questions.json";
import {
  booleanLabel,
  claimLabel,
  claimMeaning,
  claimScope,
  claimSummary,
  derivationLabel,
  evidenceModeLabel,
  fraction,
  frozenScope,
  limitations,
  metricLabel,
  metricValue,
  statusLabel,
  statusTone,
} from "../lib/claims";

const claims = questionsData.questions.flatMap((question) => question.claims);
const publicRepository = "https://github.com/I-ivan-x/agent-reliability-lab";
---

<section
  id="evidence-ledger"
  class="section ledger-section"
  data-major-section
  data-section-name="Evidence Ledger"
>
  <div class="wrap">
    <header class="section-heading heading-inline">
      <div>
        <p class="eyebrow">证据账本 · 规范注册表</p>
        <h2>每条公开结论都能回到原始产物。</h2>
      </div>
      <p>负结论与“尚未评估”不会被隐藏；使用键盘可展开完整血缘、指标推导和适用限制。</p>
    </header>

    <div class="ledger-toolbar" role="note">
      <FileCheck2 size={17} aria-hidden="true" />
      <span><strong>{claims.length} 条结论</strong> · Q1–Q5 · 由版本化注册表生成</span>
      <span class="mono">结构版本：public-claim-registry-v2</span>
    </div>

    <div class="ledger-list">
      {
        claims.map((claim) => (
          <details
            id={`evidence-${claim.claim_id}`}
            class={`ledger-item ${statusTone(claim.status)}`}
            data-claim-id={claim.claim_id}
          >
            <summary>
              <span class="ledger-claim-id mono">{claim.claim_id}</span>
              <span class="ledger-summary-copy">
                <strong>{claimLabel(claim)}</strong>
                <small>{claimScope(claim)}</small>
              </span>
              <span class="ledger-state">
                <strong>{statusLabel(claim.status)}</strong>
                <small>可作为主结论：{booleanLabel(claim.headline_eligible)}</small>
              </span>
              <ChevronDown class="ledger-chevron" size={18} aria-hidden="true" />
            </summary>

            <div class="ledger-body">
              <div class="ledger-conclusion">
                <h3>公开结论</h3>
                <p>{claimSummary(claim)}</p>
                <p class="metric-meaning">{claimMeaning(claim)}</p>
                <dl>
                  <div><dt>证据模式</dt><dd>{evidenceModeLabel(claim.evidence_mode)}</dd></div>
                  <div><dt>冻结范围</dt><dd>{frozenScope(claim)}</dd></div>
                  <div><dt>状态</dt><dd>{statusLabel(claim.status)}</dd></div>
                </dl>
              </div>

              <div class="ledger-metrics">
                <h3>指标</h3>
                {Object.keys(claim.metrics).length === 0 ? (
                  <p class="ledger-empty">无指标：该结论被明确标记为尚未评估。</p>
                ) : (
                  <div class="metric-table" role="table" aria-label={`${claim.claim_id} 指标`}>
                    {Object.entries(claim.metrics).map(([name, metric]) => (
                      <div
                        class="metric-row"
                        role="row"
                        data-metric-claim={claim.claim_id}
                        data-metric-name={name}
                      >
                        <span role="cell" title={name}>{metricLabel(name)}</span>
                        <strong role="cell">{metricValue(metric, 6)}</strong>
                        <span role="cell" class="mono">{fraction(metric)}</span>
                        <span role="cell">{derivationLabel(metric.source.derivation)}</span>
                      </div>
                    ))}
                  </div>
                )}
              </div>

              <div class="ledger-sources">
                <h3><Fingerprint size={16} aria-hidden="true" /> 来源血缘</h3>
                {claim.source_artifacts.map((source) => (
                  <dl class="source-record">
                    <div><dt>运行 ID</dt><dd class="mono">{source.run_id}</dd></div>
                    <div>
                      <dt>来源路径</dt>
                      <dd class="mono">
                        <a
                          href={`${publicRepository}/blob/${source.artifact_commit}/${source.path}`}
                          target="_blank"
                          rel="noreferrer"
                          aria-label={`在 GitHub 新标签页查看 ${source.path}，固定到产物提交`}
                        >{source.path}</a>
                      </dd>
                    </div>
                    <div><dt>产物 SHA-256</dt><dd class="mono">{source.sha256}</dd></div>
                    <div><dt>执行提交</dt><dd class="mono">{source.execution_commit}</dd></div>
                    <div><dt>产物提交</dt><dd class="mono">{source.artifact_commit}</dd></div>
                    <div><dt>发布标签</dt><dd class="mono">{source.release_tag ?? "无"}</dd></div>
                  </dl>
                ))}
              </div>

              <div class="ledger-limitations">
                <h3>适用限制</h3>
                <ul>{limitations(claim).map((limitation) => <li>{limitation}</li>)}</ul>
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
