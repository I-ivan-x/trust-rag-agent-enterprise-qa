---
import { ChevronDown } from "@lucide/astro";
import frontier from "../data/decision-frontier.json";
import q5Evidence from "../data/q5-evidence.json";
import {
  booleanLabel,
  claimLabel,
  claimMeaning,
  claimSummary,
  fraction,
  metricPercent,
  statusLabel,
} from "../lib/claims";

const claimsById = Object.fromEntries(frontier.claims.map((claim) => [claim.claim_id, claim]));
const controlled = claimsById["q5.controlled_prose_llm_necessity"];
const uplift = claimsById["q5.llm_semantic_uplift"];
const openWorld = claimsById["q5.open_world_llm_value"];
const controlledMetric = controlled.metrics.previously_uncovered_cases_resolved;
const upliftMetric = uplift.metrics.semantic_uplift;

const stateTabs = [
  ["hypothesis", "假设", "Hypothesis"],
  ["real_result", "真实结果", "Real result"],
  ["final_decision", "最终决策", "Final decision"],
] as const;
---

<section
  id="q5-decision-frontier"
  class="section frontier-section"
  data-major-section
  data-section-name="Q5 Decision Frontier"
>
  <div class="wrap">
    <header class="section-heading heading-inline">
      <div>
        <p class="eyebrow">决策边界 · 什么时候需要模型</p>
        <h2>能确定的用规则，含义开放的才考虑模型。</h2>
      </div>
      <p>先选择输入类型，再对照“假设 → 真实结果 → 最终决策”；高风险、无依据或越权请求始终在副作用前停止。</p>
    </header>

    <div class="frontier-plain-conclusion" role="note">
      <p>
        在这组受控文本里，确定性解析器解决了
        <a
          href={`#evidence-${controlled.claim_id}`}
          data-claim-id={controlled.claim_id}
          data-metric-claim={controlled.claim_id}
          data-metric-name="previously_uncovered_cases_resolved"
        >{fraction(controlledMetric)}</a>；
        大模型只带来
        <a
          href={`#evidence-${uplift.claim_id}`}
          data-claim-id={uplift.claim_id}
          data-metric-claim={uplift.claim_id}
          data-metric-name="semantic_uplift"
        >{fraction(upliftMetric)}</a>
        （{metricPercent(upliftMetric)}）的提升，没有达到预设门槛；开放语义场景尚未评估。
      </p>
    </div>

    <div class="frontier-workbench" data-frontier-workbench>
      <div
        class="segmented-control"
        role="tablist"
        aria-label="选择 Q5 输入类型"
        data-frontier-segment-tabs
      >
        {
          frontier.segments.map((segment, index) => (
            <button
              id={`frontier-segment-tab-${segment.segment_id}`}
              type="button"
              role="tab"
              aria-selected={index === 1 ? "true" : "false"}
              aria-controls={`frontier-segment-panel-${segment.segment_id}`}
              tabindex={index === 1 ? 0 : -1}
              data-frontier-segment-tab
            >
              <span>{segment.presentation.label}</span>
              <small>{segment.label}</small>
            </button>
          ))
        }
      </div>

      {
        frontier.segments.map((segment, segmentIndex) => {
          const copy = segment.presentation;
          const segmentClaims = segment.claim_ids
            .map((claimId) => claimsById[claimId])
            .filter(Boolean);
          return (
            <article
              id={`frontier-segment-panel-${segment.segment_id}`}
              class="frontier-segment-panel"
              role="tabpanel"
              aria-labelledby={`frontier-segment-tab-${segment.segment_id}`}
              data-frontier-segment-panel
              data-active={segmentIndex === 1 ? "true" : "false"}
            >
              <div class="frontier-facts">
                <dl>
                  <div><dt>处理路径</dt><dd>{copy.route}</dd></div>
                  <div><dt>解析器状态</dt><dd>{copy.parser_status}</dd></div>
                  <div><dt>是否调用模型</dt><dd>{copy.llm_called}</dd></div>
                  <div>
                    <dt>证据依据</dt>
                    <dd>{segmentClaims.map((claim) => claimLabel(claim)).join(" + ")}</dd>
                  </div>
                  <div><dt>终态</dt><dd>{copy.terminal_outcome}</dd></div>
                  <div>
                    <dt>结论状态</dt>
                    <dd>{segmentClaims.map((claim) => statusLabel(claim.status)).join(" + ")}</dd>
                  </div>
                </dl>
              </div>

              <div
                class="frontier-state"
                data-frontier-state-group
                data-segment-id={segment.segment_id}
              >
                <div class="state-tabs" role="tablist" aria-label={`${copy.label} 的结论阶段`}>
                  {
                    stateTabs.map(([stateId, labelZh, labelEn], stateIndex) => (
                      <button
                        id={`frontier-state-tab-${segment.segment_id}-${stateId}`}
                        type="button"
                        role="tab"
                        aria-selected={stateIndex === 2 ? "true" : "false"}
                        aria-controls={`frontier-state-panel-${segment.segment_id}-${stateId}`}
                        tabindex={stateIndex === 2 ? 0 : -1}
                        data-frontier-state-tab
                      >
                        <span>{labelZh}</span>
                        <small>{labelEn}</small>
                      </button>
                    ))
                  }
                </div>

                <div class="state-panels">
                  <div
                    id={`frontier-state-panel-${segment.segment_id}-hypothesis`}
                    class="state-panel"
                    role="tabpanel"
                    aria-labelledby={`frontier-state-tab-${segment.segment_id}-hypothesis`}
                    data-frontier-state-panel
                    data-active="false"
                  >
                    <span class="state-panel-label">待验证假设</span>
                    <p>{copy.hypothesis}</p>
                  </div>

                  <div
                    id={`frontier-state-panel-${segment.segment_id}-real_result`}
                    class="state-panel"
                    role="tabpanel"
                    aria-labelledby={`frontier-state-tab-${segment.segment_id}-real_result`}
                    data-frontier-state-panel
                    data-active="false"
                  >
                    <span class="state-panel-label">规范注册表中的真实结果</span>
                    <div class="state-claim-results">
                      {
                        segmentClaims.map((claim) => (
                          <a href={`#evidence-${claim.claim_id}`} data-claim-id={claim.claim_id}>
                            <strong>{claimLabel(claim)} · {statusLabel(claim.status)}</strong>
                            <span>{claimSummary(claim)}</span>
                          </a>
                        ))
                      }
                    </div>
                  </div>

                  <div
                    id={`frontier-state-panel-${segment.segment_id}-final_decision`}
                    class="state-panel"
                    role="tabpanel"
                    aria-labelledby={`frontier-state-tab-${segment.segment_id}-final_decision`}
                    data-frontier-state-panel
                    data-active="true"
                  >
                    <span class="state-panel-label">最终工程决策</span>
                    <p>{copy.final_decision}</p>
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <div class="frontier-summary" aria-label="Q5 三条核心结论">
      {[controlled, uplift, openWorld].map((claim) => (
        <a
          class="frontier-summary-card"
          href={`#evidence-${claim.claim_id}`}
          data-claim-id={claim.claim_id}
        >
          <span>{claimLabel(claim)}</span>
          <strong>{statusLabel(claim.status)}</strong>
          <p>{claimSummary(claim)}</p>
          <small>{claimMeaning(claim)}</small>
        </a>
      ))}
    </div>

    <details class="frontier-technical technical-details">
      <summary>
        <span>技术证据与审计详情</span>
        <ChevronDown size={17} aria-hidden="true" />
      </summary>
      <div class="frontier-technical-grid">
        <dl>
          <div><dt>协议状态</dt><dd>{q5Evidence.overall_status}</dd></div>
          <div><dt>受控文本轨道</dt><dd>{q5Evidence.controlled_prose_track}</dd></div>
          <div><dt>K1 批准</dt><dd>{booleanLabel(q5Evidence.k1_approved)}</dd></div>
          <div><dt>Boundary G 允许</dt><dd>{booleanLabel(q5Evidence.boundary_g_allowed)}</dd></div>
        </dl>
        <p>
          F11/F13/F17、real-dev、parser-uncovered、headline eligibility 与 anti-gaming triad
          等研究术语仅在此审计层和证据账本中保留，不作为默认叙事入口。
        </p>
      </div>
    </details>
  </div>
</section>

<script>
  const frontierRoot = document.querySelector("[data-frontier-workbench]");

  const configureTabs = (root, tabSelector, panelSelector) => {
    if (!(root instanceof HTMLElement)) return;
    const tabs = Array.from(root.querySelectorAll(tabSelector));
    const panels = Array.from(root.querySelectorAll(panelSelector));

    const activate = (tab) => {
      if (!(tab instanceof HTMLButtonElement)) return;
      for (const candidate of tabs) {
        const selected = candidate === tab;
        candidate.setAttribute("aria-selected", String(selected));
        candidate.setAttribute("tabindex", selected ? "0" : "-1");
      }
      for (const panel of panels) {
        const selected = panel.id === tab.getAttribute("aria-controls");
        panel.toggleAttribute("hidden", !selected);
        panel.setAttribute("data-active", String(selected));
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (event) => {
        let next = index;
        if (event.key === "ArrowRight" || event.key === "ArrowDown") {
          next = (index + 1) % tabs.length;
        } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
          next = (index - 1 + tabs.length) % tabs.length;
        }
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        else return;
        event.preventDefault();
        const nextTab = tabs[next];
        nextTab?.focus();
        activate(nextTab);
      });
    });

    const selected = tabs.find((tab) => tab.getAttribute("aria-selected") === "true") ?? tabs[0];
    activate(selected);
  };

  if (frontierRoot instanceof HTMLElement) {
    configureTabs(
      frontierRoot,
      ":scope > [data-frontier-segment-tabs] [data-frontier-segment-tab]",
      ":scope > [data-frontier-segment-panel]",
    );
    frontierRoot.querySelectorAll("[data-frontier-state-group]").forEach((group) => {
      configureTabs(
        group,
        ":scope > .state-tabs [data-frontier-state-tab]",
        ":scope > .state-panels [data-frontier-state-panel]",
      );
    });
  }
</script>
