---
import {
  ArrowDown,
  CircleCheck,
  Gavel,
  ShieldCheck,
} from "@lucide/astro";
import showcase from "../data/interview-showcase.json";
import questionsData from "../data/questions.json";
import { claimMeaning, fraction } from "../lib/claims";

const claims = questionsData.questions.flatMap((question) => question.claims);
const q4Safety = claims.find((claim) => claim.claim_id === "q4.release_reliability")!;
const q5Controlled = claims.find(
  (claim) => claim.claim_id === "q5.controlled_prose_llm_necessity",
)!;
const q5Uplift = claims.find((claim) => claim.claim_id === "q5.llm_semantic_uplift")!;
const safetyMetric = q4Safety.metrics.unauthorized_action_blocked;
const controlledMetric = q5Controlled.metrics.previously_uncovered_cases_resolved;
const upliftMetric = q5Uplift.metrics.semantic_uplift;
const publicSubtitle =
  "Governed Runtime, Evaluation Harness, and Decision Frontier for Tool-Using Agents";
const publicSubtitleZh =
  "面向工具调用智能体的受治理运行时、评测框架与决策边界";
---

<section id="hero" class="hero-section" data-major-section data-section-name="Hero">
  <div
    class="hero-trajectory"
    aria-hidden="true"
    data-corpus-id={showcase.corpus_id}
    data-manifest-sha={showcase.manifest_sha256}
  >
    <div class="hero-console-grid">
      <div class="console-stage console-observation">
        <Gavel size={17} />
        <span>现实任务</span>
        <strong>发布后错误率升高</strong>
        <small>请求判断原因并回滚</small>
      </div>
      <div class="console-stage console-evidence">
        <ShieldCheck size={17} />
        <span>治理动作</span>
        <strong>隔离过期与无权限证据</strong>
        <small>核验实时状态和动作权限</small>
      </div>
      <div class="console-stage console-policy">
        <Gavel size={17} />
        <span>动作提案</span>
        <strong>回滚到上一健康版本</strong>
        <small>可提出方案 · 执行需审批</small>
      </div>
      <div class="console-stage console-terminal">
        <CircleCheck size={17} />
        <span>可理解结果</span>
        <strong>等待人工审批</strong>
        <small>执行前安全停止 · 副作用为零</small>
      </div>
    </div>
    <div class="hero-query">{showcase.incident.request}</div>
  </div>

  <div class="wrap hero-content">
    <div class="hero-kicker">
      <span class="status-dot status-dot-pass"></span>
      <span class="hero-project-name">Agent Reliability Lab</span>
      <span class="kicker-separator" aria-hidden="true"></span>
      <span>公开安全的合成事故演示</span>
    </div>

    <h1>智能体能提议，<br /><span>但不能越权执行。</span></h1>
    <p class="hero-lead">
      <span class="hero-product-line" data-public-subtitle={publicSubtitle}>{publicSubtitleZh}</span>
      我构建的不是只会调用工具的聊天 Demo，而是把证据、权限、审批和公开结论都纳入门禁的
      工程系统。页面用一次虚构的 SaaS 发布事故展示：系统核对当前手册与实时状态，提出回滚；
      权限不足时在副作用前转交人工。
    </p>

    <div class="hero-mobile-story" aria-label="事故处理结果">
      <span><strong>现实任务</strong>{showcase.incident.request}</span>
      <span><strong>治理动作</strong>{showcase.journey[4].detail}</span>
      <span><strong>当前结果</strong>{showcase.journey[5].detail}</span>
    </div>

    <div class="hero-metrics" aria-label="核心结果">
      <a
        href={`#evidence-${q4Safety.claim_id}`}
        class="hero-metric"
        data-claim-id={q4Safety.claim_id}
        data-metric-claim={q4Safety.claim_id}
        data-metric-name="unauthorized_action_blocked"
      >
        <ShieldCheck size={18} aria-hidden="true" />
        <span class="metric-value">{fraction(safetyMetric)}</span>
        <span class="metric-label">冻结评测复验：未授权动作全部阻断</span>
        <span class="metric-scope">{claimMeaning(q4Safety)}</span>
      </a>
      <a
        href={`#evidence-${q5Controlled.claim_id}`}
        class="hero-metric"
        data-claim-id={q5Controlled.claim_id}
        data-metric-claim={q5Controlled.claim_id}
        data-metric-name="previously_uncovered_cases_resolved"
      >
        <Gavel size={18} aria-hidden="true" />
        <span class="metric-value">{fraction(controlledMetric)}</span>
        <span class="metric-label">冻结受控文本：确定性解析器解决</span>
        <span class="metric-scope">{claimMeaning(q5Controlled)}</span>
      </a>
      <a
        href={`#evidence-${q5Uplift.claim_id}`}
        class="hero-metric metric-negative"
        data-claim-id={q5Uplift.claim_id}
        data-metric-claim={q5Uplift.claim_id}
        data-metric-name="semantic_uplift"
      >
        <Gavel size={18} aria-hidden="true" />
        <span class="metric-value">{fraction(upliftMetric)}</span>
        <span class="metric-label">当前开发范围：模型增益未达到门槛</span>
        <span class="metric-scope">{claimMeaning(q5Uplift)}</span>
      </a>
    </div>

    <div class="hero-actions">
      <a class="button button-primary" href="#governed-runtime">
        看受治理轨迹 <ArrowDown size={17} aria-hidden="true" />
      </a>
      <a class="button button-secondary" href="#q5-decision-frontier">直接看 Q5 决策边界</a>
    </div>
  </div>
</section>
