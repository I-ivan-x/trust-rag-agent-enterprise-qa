---
import {
  CircleCheck,
  FileCheck2,
  Gavel,
  ScanSearch,
  Send,
} from "@lucide/astro";

const stages = [
  {
    key: "01",
    label: "Observation",
    detail: "typed tool output",
    tone: "stage-cyan",
    Icon: ScanSearch,
  },
  {
    key: "02",
    label: "Evidence",
    detail: "ACL-surviving only",
    tone: "stage-cyan",
    Icon: FileCheck2,
  },
  {
    key: "03",
    label: "Proposal",
    detail: "strict schema",
    tone: "stage-silver",
    Icon: Send,
  },
  {
    key: "04",
    label: "Policy",
    detail: "reauthorize + validate",
    tone: "stage-amber",
    Icon: Gavel,
  },
  {
    key: "05",
    label: "Terminal",
    detail: "sink or safe stop",
    tone: "stage-emerald",
    Icon: CircleCheck,
  },
];
---

<div class="runtime-pipeline" aria-label="Governed runtime stages">
  {
    stages.map(({ key, label, detail, tone, Icon }) => (
      <div class={`pipeline-stage ${tone}`}>
        <span class="pipeline-icon"><Icon size={17} strokeWidth={1.8} aria-hidden="true" /></span>
        <div>
          <span class="mono pipeline-key">{key}</span>
          <strong>{label}</strong>
          <small>{detail}</small>
        </div>
      </div>
    ))
  }
</div>
