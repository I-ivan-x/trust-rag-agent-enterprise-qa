---
import audit from "../data/audit.json";
import triad from "../data/triad.json";
const blocked = audit.blocked.length;
const stages = [
  { k: "读", t: "检索", span: "RETRIEVER", cls: "bg-detect/15 text-detect" },
  { k: "判", t: "条件 + 四道 gate", span: "GUARDRAIL", cls: "bg-detect/15 text-detect" },
  { k: "动", t: "控制器拟议", span: "AGENT", cls: "bg-brand/15 text-brand" },
  { k: "治", t: "validator + sink", span: "TOOL", cls: "bg-pending/15 text-pending" },
];
---

<section id="trust" class="border-t border-line/40">
  <div class="wrap stage stage-center">
    <p class="eyebrow reveal">可信设计</p>
    <h2 class="reveal measure mt-7 display-2">每一步都被门控，<br /><span class="gradient-text">每个动作都被追溯。</span></h2>
    <p class="reveal mx-auto mt-7 max-w-2xl lead">副作用动作要先过 ACL × 证据 × 风险层才执行；越权或无证据一律拒绝并升级。每个阶段映射到 OpenInference 标准 span。</p>

    <div class="reveal mx-auto mt-14 grid max-w-4xl gap-3 md:grid-cols-4">
      {
        stages.map((s, i) => (
          <div class="relative">
            <div class="card card-hover glass h-full p-5 text-left">
              <div class="flex items-center justify-between">
                <span class={`grid h-10 w-10 place-items-center rounded-full font-mono text-base font-bold ${s.cls}`}>{s.k}</span>
                <span class="num rounded border border-line px-1.5 py-0.5 text-[10px] text-faint">{s.span}</span>
              </div>
              <h3 class="mt-3 text-sm font-semibold">{s.t}</h3>
            </div>
            {i < stages.length - 1 && (
              <svg class="absolute -right-3 top-1/2 hidden h-3 w-6 -translate-y-1/2 md:block" viewBox="0 0 24 12">
                <line x1="0" y1="6" x2="24" y2="6" stroke="#34d399" stroke-width="2" class="flow-dash" opacity="0.7" />
              </svg>
            )}
          </div>
        ))
      }
    </div>

    <div class="reveal mt-20 flex flex-wrap items-end justify-center gap-12 sm:gap-20">
      <div>
        <div class="num text-5xl font-extrabold text-brand sm:text-7xl">0 · 0</div>
        <div class="mt-3 text-sm text-muted">越权执行 (F13) · 无证据执行 (F11)</div>
      </div>
      <div class="hidden h-16 w-px bg-line sm:block sm:h-20"></div>
      <div>
        <div class="num text-5xl font-extrabold sm:text-7xl">{triad.after.rule.unauthorized_action_blocked.toFixed(2)}</div>
        <div class="mt-3 text-sm text-muted">越权动作拦截率（留出 {blocked} 例全拦）</div>
      </div>
    </div>
    <p class="reveal num mt-6 text-xs text-faint">fail-closed 实测：q4-p5-selection-calibrated</p>
  </div>
</section>
