---
import {
  CircleCheck,
  FileCheck2,
  Gavel,
  ScanSearch,
  Send,
} from "@lucide/astro";

const stages = [
  {
    key: "01",
    label: "接收请求",
    detail: "诊断并尝试回滚",
    tone: "stage-cyan",
    Icon: ScanSearch,
  },
  {
    key: "02",
    label: "找证据",
    detail: "当前手册 + 实时状态",
    tone: "stage-cyan",
    Icon: FileCheck2,
  },
  {
    key: "03",
    label: "提出动作",
    detail: "回滚上一健康版本",
    tone: "stage-silver",
    Icon: Send,
  },
  {
    key: "04",
    label: "权限检查",
    detail: "允许提议，不允许执行",
    tone: "stage-amber",
    Icon: Gavel,
  },
  {
    key: "05",
    label: "等待审批",
    detail: "执行前安全停止",
    tone: "stage-emerald",
    Icon: CircleCheck,
  },
];
---

<div class="runtime-pipeline" aria-label="受治理运行时阶段">
  {
    stages.map(({ key, label, detail, tone, Icon }) => (
      <div class={`pipeline-stage ${tone}`}>
        <span class="pipeline-icon"><Icon size={17} strokeWidth={1.8} aria-hidden="true" /></span>
        <div>
          <span class="mono pipeline-key">{key}</span>
          <strong>{label}</strong>
          <small>{detail}</small>
        </div>
      </div>
    ))
  }
</div>
