---
import {
  AlertTriangle,
  CircleCheck,
  CircleX,
  MinusCircle,
} from "@lucide/astro";
import questionsData from "../data/questions.json";
import { questionLabel, statusLabel, statusTone } from "../lib/claims";
const defenseCopy: Record<string, { title: string; outcome: string }> = {
  Q1: { title: "证据是否可信？", outcome: "证据不足时拒答，不凭空补全" },
  Q2: { title: "动态事实是否补齐？", outcome: "有界观察，不让循环无限延长" },
  Q3: { title: "动作是否有权限？", outcome: "提案必须经过证据与权限校验" },
  Q4: { title: "能否少打扰人工？", outcome: "维持安全底线，同时减少错误升级" },
  Q5: { title: "什么时候才需要模型？", outcome: "规则能确定的不用模型，未知范围不冒充结论" },
};

const rows = questionsData.questions;
---

<section
  id="five-questions"
  class="section section-compact questions-section"
  data-major-section
  data-section-name="Five Questions"
>
  <div class="wrap">
    <header class="section-heading heading-inline">
      <div>
        <p class="eyebrow">一次事故 · 五道防线</p>
        <h2>从“找到证据”到“等待审批”，每一步都能停下来。</h2>
      </div>
      <p>面试默认路径先讲系统解决了什么；研究范围、指标推导和完整血缘放在页面末尾供深挖。</p>
    </header>

    <ol class="question-list">
      {
        rows.map((row) => (
          <li class={`question-row ${statusTone(row.status)}`} data-question-id={row.question_id}>
            <div class="question-index">
              {row.status === "demonstrated_in_frozen_scope" ? (
                <CircleCheck size={18} aria-hidden="true" />
              ) : row.status === "mixed_scoped_results" ? (
                <AlertTriangle size={18} aria-hidden="true" />
              ) : row.status === "not_evaluated" ? (
                <MinusCircle size={18} aria-hidden="true" />
              ) : (
                <CircleX size={18} aria-hidden="true" />
              )}
              <span>{row.question_id}</span>
            </div>
            <div class="question-copy">
              <h3>{defenseCopy[row.question_id].title}</h3>
              <p>{defenseCopy[row.question_id].outcome}</p>
            </div>
            <div class="question-status">
              <strong>{statusLabel(row.status)}</strong>
              <span>{questionLabel(row.question_id, row.question)}</span>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
