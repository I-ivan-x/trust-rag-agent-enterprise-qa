{
  "$defs": {
    "ClaimMetric": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "exclusiveMinimum": 0,
          "title": "Denominator",
          "type": "number"
        },
        "numerator": {
          "title": "Numerator",
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/ClaimMetricSource"
        },
        "unit": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "numerator",
        "denominator",
        "value",
        "unit",
        "source"
      ],
      "title": "ClaimMetric",
      "type": "object"
    },
    "ClaimMetricSource": {
      "additionalProperties": false,
      "properties": {
        "denominator_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator Pointer"
        },
        "derivation": {
          "$ref": "#/$defs/MetricDerivation"
        },
        "left_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Left Pointer"
        },
        "numerator_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator Pointer"
        },
        "right_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Right Pointer"
        },
        "source_path": {
          "minLength": 1,
          "pattern": "^[^\\\\]+$",
          "title": "Source Path",
          "type": "string"
        },
        "tolerance": {
          "exclusiveMinimum": 0,
          "maximum": 0.01,
          "title": "Tolerance",
          "type": "number"
        },
        "value_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Pointer"
        }
      },
      "required": [
        "source_path",
        "derivation",
        "tolerance"
      ],
      "title": "ClaimMetricSource",
      "type": "object"
    },
    "ClaimSourceArtifact": {
      "additionalProperties": false,
      "properties": {
        "archived_from_path": {
          "minLength": 1,
          "pattern": "^[^\\\\]+$",
          "title": "Archived From Path",
          "type": "string"
        },
        "artifact_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Artifact Commit",
          "type": "string"
        },
        "execution_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Execution Commit",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "^[^\\\\]+$",
          "title": "Path",
          "type": "string"
        },
        "release_commit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Commit"
        },
        "release_tag": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Tag"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "tag_object_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tag Object Sha"
        }
      },
      "required": [
        "path",
        "archived_from_path",
        "sha256",
        "run_id",
        "execution_commit",
        "artifact_commit"
      ],
      "title": "ClaimSourceArtifact",
      "type": "object"
    },
    "ClaimStatus": {
      "enum": [
        "demonstrated_in_frozen_scope",
        "falsified_in_current_scope",
        "not_evaluated"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "EvidenceMode": {
      "enum": [
        "real",
        "mock",
        "synthetic",
        "replay",
        "offline_control"
      ],
      "title": "EvidenceMode",
      "type": "string"
    },
    "MetricDerivation": {
      "enum": [
        "direct",
        "ratio",
        "rate_from_value",
        "difference",
        "boolean"
      ],
      "title": "MetricDerivation",
      "type": "string"
    },
    "PublicClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^q[1-5]\\.[a-z][a-z0-9_]*$",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_scope": {
          "minLength": 1,
          "title": "Claim Scope",
          "type": "string"
        },
        "evidence_mode": {
          "$ref": "#/$defs/EvidenceMode"
        },
        "headline_eligible": {
          "title": "Headline Eligible",
          "type": "boolean"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/ClaimMetric"
          },
          "title": "Metrics",
          "type": "object"
        },
        "public_label": {
          "minLength": 1,
          "title": "Public Label",
          "type": "string"
        },
        "public_summary": {
          "minLength": 1,
          "title": "Public Summary",
          "type": "string"
        },
        "question_id": {
          "enum": [
            "Q1",
            "Q2",
            "Q3",
            "Q4",
            "Q5"
          ],
          "title": "Question Id",
          "type": "string"
        },
        "source_artifacts": {
          "items": {
            "$ref": "#/$defs/ClaimSourceArtifact"
          },
          "minItems": 1,
          "title": "Source Artifacts",
          "type": "array"
        },
        "split_or_frozen_scope": {
          "minLength": 1,
          "title": "Split Or Frozen Scope",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ClaimStatus"
        }
      },
      "required": [
        "claim_id",
        "question_id",
        "public_label",
        "status",
        "claim_scope",
        "evidence_mode",
        "split_or_frozen_scope",
        "source_artifacts",
        "metrics",
        "headline_eligible",
        "limitations",
        "public_summary"
      ],
      "title": "PublicClaim",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/PublicClaim"
      },
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "legacy_codename": {
      "const": "TrustRAG",
      "title": "Legacy Codename",
      "type": "string"
    },
    "project_public_name": {
      "const": "Agent Reliability Lab",
      "title": "Project Public Name",
      "type": "string"
    },
    "q5_overall_status": {
      "const": "scoped_negative_complete",
      "title": "Q5 Overall Status",
      "type": "string"
    },
    "schema_version": {
      "const": "public-claim-registry-v2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "project_public_name",
    "legacy_codename",
    "q5_overall_status",
    "claims"
  ],
  "title": "ClaimRegistry",
  "type": "object"
}
